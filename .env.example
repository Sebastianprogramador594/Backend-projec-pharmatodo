# ========================================================
# Variables de Entorno - PharmaTodo
# ========================================================

# Puerto del Servidor Backend (en Railway se asigna automáticamente)
PORT=3000

# Clave secreta para generación y validación de tokens JWT
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_de_al_menos_32_caracteres

# --------------------------------------------------------
# Configuración de Base de Datos MySQL
# --------------------------------------------------------
# OPCIÓN A: Conexión mediante URL completa (estándar en Railway con servicio MySQL)
# MYSQL_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway
# DATABASE_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway

# OPCIÓN B: Conexión mediante parámetros individuales
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmatodo

# O con los nombres predeterminados que inyecta Railway:
# MYSQLHOST=mysql.railway.internal
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=tu_password
# MYSQLDATABASE=railway

# Activar SSL si el proveedor MySQL lo requiere (true / false)
DB_SSL=false
